#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
catalog=${CATALOG:-"$repo_root/catalog/demos.tsv"}
mlpl=${MLPL:-"$repo_root/../sw-mlpl/target/debug/mlpl-repl"}

[ -x "$mlpl" ] || { echo "mlpl-repl is not executable: $mlpl" >&2; exit 1; }
"$repo_root/scripts/validate-catalog" "$catalog"

tab=$(printf '\t')
ran=0
while IFS="$tab" read -r id path concept dynamic_size explicit_loops required_features status; do
  [ "$id" = "id" ] && continue
  [ -z "$id" ] && continue
  [ "$status" = "runnable" ] || continue
  echo "RUN $id"
  "$mlpl" --source-dir "$repo_root" "$repo_root/$path"
  ran=$((ran + 1))
done < "$catalog"

echo "PASS $ran catalog demo(s)"
