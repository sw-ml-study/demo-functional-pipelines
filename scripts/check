#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
"$repo_root/scripts/audit-repository"
"$repo_root/scripts/test-record-lookup" >/dev/null
"$repo_root/scripts/run-all" >/dev/null
test -s "$repo_root/docs/upstream-contract.md"
test -s "$repo_root/catalog/README.md"
test "$(cat "$repo_root/COPYRIGHT")" = "Copyright (c) 2026 Michael A Wright"
grep -q '^MIT License$' "$repo_root/LICENSE"
grep -q '^## Copyright and license$' "$repo_root/README.md"
grep -q '^Copyright (c) 2026 Michael A Wright\. See \[COPYRIGHT\](COPYRIGHT)\.$' "$repo_root/README.md"
grep -q '^This project is available under the \[MIT License\](LICENSE)\.$' "$repo_root/README.md"
git -C "$repo_root" diff --check
echo "PASS pre-commit"
