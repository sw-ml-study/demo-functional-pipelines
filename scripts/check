#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
sh -n "$repo_root/scripts/check" "$repo_root/scripts/run-map-filter-reduce" "$repo_root/scripts/validate-catalog"
"$repo_root/scripts/validate-catalog" "$repo_root/catalog/demos.tsv"
"$repo_root/scripts/run-map-filter-reduce" >/dev/null
test -s "$repo_root/docs/upstream-contract.md"
test -s "$repo_root/catalog/README.md"
git -C "$repo_root" diff --check
echo "PASS pre-commit"
