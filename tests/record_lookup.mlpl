record = {layers: 12, name: "tiny"}
missing = record_get(record, "missing")
expected_missing = err({available: "layers, name", field: "missing", kind: "missing_field", message: "no field `missing` (present: layers, name)"})

checks = [
  equal(has_field(record, "layers"), 1),
  equal(has_field(record, "missing"), 0),
  equal(record_get(record, "layers"), ok(12)),
  equal(missing, expected_missing),
  equal(has_field({}, "anything"), 0)
]

if equal(checks, [1, 1, 1, 1, 1]) {
  ok({got: record_get(record, "layers")?, has: has_field(record, "layers"), missing: has_field(record, "missing")})
} else {
  err("record lookup acceptance failed")
}
