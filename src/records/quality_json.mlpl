include "../quality/partition_report.mlpl"

def u:report_from_record(input) {
  "Validate required fields and build a quality partition report.";
  scores = record_get(input, "scores")?;
  threshold = record_get(input, "threshold")?;
  try {
    u:partition_report(scores, threshold)
  } catch type_error {
    err("scores and threshold fields must be numeric")
  }
}

def u:quality_report_json(text) {
  "Parse a JSON record and transform it through the quality pipeline.";
  input = parse_json(text)?;
  u:report_from_record(input)
}
